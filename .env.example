# Last.fm API keys — separate keys so backend (cache miss) and collector
# (high-rate crawl) don't share a rate-limit bucket.
# Get them from: https://www.last.fm/api/account/create
LASTFM_API_KEY=your_backend_lastfm_key_here
LASTFM_COLLECTOR_API_KEY=your_collector_lastfm_key_here

# Logging level
RUST_LOG=info

# Data file paths. Unset, the backend uses ../../data/ relative to its working
# directory (right for `cargo run` in web/backend); systemd units need absolute paths:
# METADATA_PATH=/home/artistpath/Services/artistpath/data/metadata.bin
# GRAPH_PATH=/home/artistpath/Services/artistpath/data/graph.bin
# REVERSE_GRAPH_PATH=/home/artistpath/Services/artistpath/data/rev-graph.bin
# LASTFM_CACHE_PATH=/home/artistpath/Services/artistpath/data/lastfm-cache/artist_metadata.bin

# Backend listen address (the ops/ units and the tunnel assume the default)
# BIND_ADDR=127.0.0.1:3050

# Healthchecks.io UUIDs (optional, for monitoring)
# HC_BACKEND_UUID=
# HC_COLLECTOR_UUID=
# HC_REFRESH_UUID=

# Cloudflare Pages Edit token (to publish report)
CLOUDFLARE_API_TOKEN=your_cloudflare_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
