# Last.fm API keys — separate keys so backend (cache miss) and collector
# (high-rate crawl) don't share a rate-limit bucket.
# Get them from: https://www.last.fm/api/account/create
LASTFM_API_KEY=your_backend_lastfm_key_here
LASTFM_COLLECTOR_API_KEY=your_collector_lastfm_key_here

# Logging level
RUST_LOG=info

# Data file paths (absolute paths for systemd)
METADATA_PATH=/var/home/klimasos/Services/artistpath/data/metadata.bin
GRAPH_PATH=/var/home/klimasos/Services/artistpath/data/graph.bin
REVERSE_GRAPH_PATH=/var/home/klimasos/Services/artistpath/data/rev-graph.bin
LASTFM_CACHE_PATH=/var/home/klimasos/Services/artistpath/data/artist_metadata.bin

# Healthchecks.io UUIDs (optional, for monitoring)
# HC_BACKEND_UUID=
# HC_COLLECTOR_UUID=
# HC_REFRESH_UUID=

# Cloudflare Pages Edit token (to publish report)
CLOUDFLARE_API_TOKEN=your_cloudflare_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
