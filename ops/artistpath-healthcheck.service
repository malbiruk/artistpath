[Unit]
Description=Artistpath Backend Health Check

[Service]
Type=oneshot
EnvironmentFile=%h/.config/artistpath/healthcheck.env
# Collector: ping only if it saved state within the last 30 minutes (it saves
# every 10 minutes). Prefixed with "-" so a silent collector does not stop the
# backend check below from running.
ExecStart=-/bin/sh -c '[ -z "$HC_COLLECTOR_UUID" ] || [ $(( $(date +%%s) - $(stat -c %%Y %h/Services/artistpath/data/collection_state.json) )) -gt 1800 ] || curl -fsS -m 10 --retry 3 "https://hc-ping.com/$HC_COLLECTOR_UUID"'
ExecStart=/bin/sh -c 'curl -fsS -m 10 http://localhost:3050/health && curl -fsS -m 10 --retry 3 https://hc-ping.com/${HC_BACKEND_UUID}'
