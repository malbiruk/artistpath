[Unit]
Description=Artistpath Backend API Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Services/artistpath
ExecStart=%h/Services/artistpath/web/backend/target/release/artistpath-web
EnvironmentFile=%h/.config/artistpath/backend.env
Restart=on-failure
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=default.target
